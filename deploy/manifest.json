{
  "schema": 1,
  "product": "CIZHENYU AGENT",
  "repo": "https://github.com/youcizi-art/cizhenyu_dsh_agent.git",
  "strategy": "B",
  "install": {
    "target": "{workRoot}/agents/dsh_agent",
    "fetch": "github-zip",
    "owner": "youcizi-art",
    "name": "cizhenyu_dsh_agent",
    "branch": "master",
    "post": ["npm install"],
    "preserve": ["home", "node_modules"]
  },
  "kernel": {
    "npmPackage": "@deepseek-ai/dsh",
    "npmVersion": "0.2.2-rc.5",
    "note": "Official MIT kernel; productization via plugins only"
  },
  "market": {
    "npmPackage": "dshmarket",
    "npmVersion": "1.77.1",
    "profile": "web",
    "install": "dsh plugin --profile web add",
    "catalog": "https://github.com/awesome-dsh-plugin/awesome-dsh-plugin",
    "repo": "https://github.com/dsh-market/dsh-market",
    "note": "Plan A: community storefront preinstalled into DSH_HOME web profile on Agent install"
  },
  "plugins": [
    {
      "id": "ui-brand-cizhenyu",
      "npmName": "@cizhenyu/dsh-client-ui-brand",
      "path": "packages/dsh-client-ui-brand",
      "cordisPatch": "deploy/cordis.brand.patch.yml",
      "role": "web-client-brand"
    },
    {
      "id": "cizhenyu-ext",
      "npmName": "@cizhenyu/dsh-ext",
      "path": "packages/dsh-ext",
      "cordisPatch": "deploy/cordis.brand.patch.yml",
      "role": "product-ext"
    }
  ]
}
