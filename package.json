{
  "name": "cizhenyu-dsh-agent",
  "private": true,
  "version": "0.1.0",
  "description": "CIZHENYU AGENT install root: official @deepseek-ai/dsh + brand + product ext plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youcizi-art/cizhenyu_dsh_agent.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@cizhenyu/dsh-client-ui-brand": "file:./packages/dsh-client-ui-brand",
    "@cizhenyu/dsh-ext": "file:./packages/dsh-ext"
  },
  "cizhenyu": {
    "kind": "dsh-agent-install",
    "productName": "CIZHENYU AGENT",
    "dshHomeRelative": "home",
    "cordisBrandPatch": "deploy/cordis.brand.patch.yml",
    "defaultPort": 13880
  }
}
